# ==============================================================================
# People Remotely — Production Environment Configuration Template
# ==============================================================================
# Copy this template to .env on the production server (/var/www/peopleremotely/.env)
# Replace all placeholder values (YOUR_*) with actual production secrets.
# NEVER commit the real .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend & Next.js Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://peopleremotely.com
NEXT_PUBLIC_SITE_URL=https://peopleremotely.com
NEXT_PUBLIC_DJANGO_API_URL=https://peopleremotely.com
NEXT_PUBLIC_API_URL=https://peopleremotely.com
NEXT_PUBLIC_AUTH_PROVIDER=django

# Google Site Verification (Search Console)
GOOGLE_SITE_VERIFICATION=YOUR_GOOGLE_SITE_VERIFICATION_TOKEN

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Authorization
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Comma-separated admin email addresses
ADMIN_EMAILS=admin@peopleremotely.com

# ------------------------------------------------------------------------------
# 3. Backend & Django Security Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=YOUR_STRONG_DJANGO_SECRET_KEY_HERE
DEBUG=False
ALLOWED_HOSTS=peopleremotely.com,www.peopleremotely.com,15.207.215.32,10.0.1.201,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://peopleremotely.com,https://www.peopleremotely.com
FRONTEND_URL=https://peopleremotely.com

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=peopleremotely_prod
DB_USER=peopleremotely_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DATABASE_URL=postgresql://peopleremotely_user:YOUR_STRONG_DATABASE_PASSWORD@127.0.0.1:5432/peopleremotely_prod

# ------------------------------------------------------------------------------
# 5. Redis & Celery Asynchronous Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ------------------------------------------------------------------------------
# 6. AWS S3 Storage (Resumes & Logos)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_STORAGE_BUCKET_NAME=YOUR_AWS_STORAGE_BUCKET_NAME
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# 7. Email Notifications (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=People Remotely <notifications@peopleremotely.com>
PEOPLE_PRIME_HANDOFF_EMAIL=remote@people-prime.com

# ------------------------------------------------------------------------------
# 8. AI & Machine Learning Services (OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 9. External Job Feed Providers (Discovery & Aggregation)
# ------------------------------------------------------------------------------
OPENWEB_NINJA_API_KEY=YOUR_OPENWEB_NINJA_API_KEY
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
ADZUNA_COUNTRY=us
HIMALAYAS_API_URL=https://himalayas.app/jobs/api
